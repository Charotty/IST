# OKX API ключи для реальных данных
# Скопируйте этот файл в .env и заполните своими данными

OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here
OKX_SANDBOX=true

# Пример реальных ключей (замените на свои):
# OKX_API_KEY=your-actual-api-key
# OKX_SECRET_KEY=your-actual-secret-key  
# OKX_PASSPHRASE=your-actual-passphrase
# OKX_SANDBOX=false
